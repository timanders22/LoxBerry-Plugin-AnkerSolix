#!/bin/bash
# Anker SOLIX - Deinstallation
#
# Zwei Aufgaben, beide unverzichtbar:
#
# 1. DIE ANLAGE FREIGEBEN. Anker kennt keinen Watchdog: ein gesetzter
#    Hauslast-Sollwert bleibt stehen, auch wenn nie wieder jemand danach
#    fragt. Wer das Plugin entfernt, waehrend die Solarbank auf einem
#    gestellten Wert steht, laesst eine Anlage zurueck, die etwas tut, und
#    niemand weiss mehr, warum. Deshalb wird - und nur dann, wenn die
#    Steuerung ueberhaupt freigegeben war - einmal die Betriebsart
#    "eigenverbrauch" gesendet. Genau das empfiehlt die README dem Anwender
#    fuer das geplante Herunterfahren von Loxone.
#
# 2. DIE SICHERUNGEN ABRAEUMEN. plugininstall.pl entfernt nur das
#    VERZEICHNIS config/plugins/<ordner>/. Was eine Ebene darueber liegt,
#    bleibt - und preupgrade.sh legt dort zwei Dateien ab, eine davon mit
#    dem Anker-Kontopasswort im Klartext. Zwei Folgen, beide unerwuenscht:
#      a) Das Cloud-Passwort liegt unbegrenzt im Dateisystem.
#      b) Eine spaetere NEUinstallation fand die alte Konfiguration samt
#         altem Aktionstoken vor und stellte sie stillschweigend wieder her
#         (ak_lib.php, ak_config). Eine "saubere" Neuinstallation war das
#         nicht.
#
# Aufruf durch den Installer: data/system/uninstall/<name>
#   <TEMPFILE> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
# Ordner und Wurzel kommen deshalb aus $3 und $5. Bis hierher wurde der Ordner
# aus dem eigenen Ablageort abgeleitet - installiert ist das data/system, der
# Ordnername wurde "system" (am Geraet so errechnet, 17.09.2026; Regeln/06).
SELF=$(cd "$(dirname "$0")" && pwd)
ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-ankersolix}"
BASE="${ARGV5:-$LBHOMEDIR}"
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(cd "$SELF/../../.." 2>/dev/null && pwd)
fi
# K17 (seit 0.9.32, Form preinstall.sh): der Ordnername darf keinen Pfadtrenner
# tragen, und Wurzel ist nur, was config/plugins, data/plugins UND
# config/system/general.json traegt (Regeln/06) - sonst griffen rm und mv
# daneben. Bis 0.9.31 genuegte ein Verzeichnis.
case "$PFOLDER" in
    ''|*/*|.|..) echo "<FAIL> Unzulaessiger Ordnername '$PFOLDER' - nichts angefasst."; exit 1 ;;
esac
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ] \
   || [ ! -f "$BASE/config/system/general.json" ]; then
    echo "<WARNING> Kein LoxBerry-Wurzelverzeichnis erkannt ('$BASE') - nichts angefasst."
    exit 1
fi

PBIN="$BASE/bin/plugins/$PFOLDER"
PCONFIG="$BASE/config/plugins/$PFOLDER"
DIENST="$PBIN/dienst.sh"
PY="$PBIN/venv/bin/python3"
SKRIPT="$PBIN/ankersolix.py"

# ---------- Die eigenen Prozesse erkennen ----------
#
# Argumentweise (Regeln/03, "Prozesse argumentweise erkennen"): argv[0] ist ein
# Python, argv[1] ist genau der eigene Dienstpfad, ein drittes Argument gibt es
# nicht. Bis 0.9.17 stand hier eine Teilzeichenkettensuche
# (grep -qa "ankersolix.py"), und sie traf jede Befehlszeile, in der der Name
# irgendwo vorkommt. In WSL gemessen (Pruefung-AnkerSolix-0.9.17, Fall 7): ein
# fremder Prozess "python3 -c … <dienstpfad>", dessen Nummer in der PID-Datei
# stand, war nach der Deinstallation tot.
#
# Das dritte Argument schliesst den Einmallauf --freigeben aus Abschnitt 2 aus:
# er laeuft mit demselben Interpreter und demselben Skript, ist aber nicht der
# Dauerlaeufer.
AK_SKRIPT="$SKRIPT"
AK_SKRIPT_R=$(readlink -f "$AK_SKRIPT" 2>/dev/null)
[ -n "$AK_SKRIPT_R" ] || AK_SKRIPT_R="$AK_SKRIPT"
AK_UID=$(id -u loxberry 2>/dev/null || id -u)

ak_ist_dienst() {
    [ -r "/proc/$1/cmdline" ] || return 1
    {
        IFS= read -r -d '' ak_a0 || return 1
        IFS= read -r -d '' ak_a1 || return 1
        case "${ak_a0##*/}" in python|python3|python3.*) ;; *) return 1 ;; esac
        if [ "$ak_a1" != "$AK_SKRIPT" ]; then
            [ "$(readlink -f "$ak_a1" 2>/dev/null)" = "$AK_SKRIPT_R" ] || return 1
        fi
        IFS= read -r -d '' ak_a2 && return 1
        return 0
    } < "/proc/$1/cmdline"
}

# Alle eigenen Dienste des eigenen Benutzers - auch die ohne PID-Datei.
ak_dienste() {
    for ak_d in /proc/[0-9]*; do
        ak_ist_dienst "${ak_d#/proc/}" || continue
        [ "$(stat -c %u "$ak_d" 2>/dev/null)" = "$AK_UID" ] || continue
        echo "${ak_d#/proc/}"
    done
    return 0
}

# Beendet sie: freundlich, bis zu zehn Sekunden Zeit, dann hart - und vor JEDEM
# Signal wird neu gesucht, auch vor dem kill -9.
ak_dienste_beenden() {
    ak_ziel=$(ak_dienste)
    [ -n "$ak_ziel" ] || return 0
    kill $ak_ziel 2>/dev/null
    ak_i=0
    while [ $ak_i -lt 10 ] && [ -n "$(ak_dienste)" ]; do
        sleep 1
        ak_i=$((ak_i + 1))
    done
    ak_rest=$(ak_dienste)
    [ -n "$ak_rest" ] && kill -9 $ak_rest 2>/dev/null
    echo $ak_ziel
}

# ---------- 0. Die Befehlsbruecke (seit 0.9.32, E-E3; Bauart Ferien 1.2.29) ----------
# Vor allem anderen anhalten (stop beendet Dienst und mosquitto_sub, auch ein
# verwaistes), argumentweise nachzaehlen, die Optionsdateien mit dem
# Broker-Kennwort ueberschreiben und den Ordner befehle/ entfernen. Im Broker
# bleibt nichts: Quittungen und status/befehle sind nie zurueckbehalten.
BBSH="$PBIN/befehlsbruecke.sh"
BBPHP="$PBIN/befehlsbruecke.php"
BBDIR="$BASE/data/plugins/$PFOLDER/befehle"
if [ -f "$BBSH" ]; then
    timeout 40 bash "$BBSH" stop
fi
BB_REST=0
for d in /proc/[0-9]*; do
    mapfile -d '' -t a 2>/dev/null < "$d/cmdline" || continue
    if [ "${#a[@]}" -eq 2 ] && [ "${a[1]}" = "$BBPHP" ] && [[ "${a[0]}" =~ (^|/)php[0-9.]*$ ]]; then
        kill -9 "${d#/proc/}" 2>/dev/null
        BB_REST=$((BB_REST + 1))
    fi
done
BB_ABOS=0
for d in /proc/[0-9]*; do
    read -r c 2>/dev/null < "$d/comm" || continue
    [ "$c" = "mosquitto_sub" ] || continue
    mapfile -d '' -t e 2>/dev/null < "$d/environ" || continue
    for x in "${e[@]}"; do
        if [ "$x" = "XDG_CONFIG_HOME=$BBDIR/mosquitto" ]; then kill -9 "${d#/proc/}" 2>/dev/null; BB_ABOS=$((BB_ABOS + 1)); fi
    done
done
[ "$BB_REST" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_REST Dienst(e) erst mit kill -9 beendet."
[ "$BB_ABOS" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_ABOS mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ]; then
    for f in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$f" ]; then
            n=$(stat -c %s "$f" 2>/dev/null || echo 64)
            head -c "$n" /dev/zero > "$f" 2>/dev/null
        fi
    done
    rm -rf "${BBDIR:?}"
fi
if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
    echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
elif [ -f "$BBSH" ]; then
    echo "<OK> Befehlsbruecke angehalten, ihre Zugangsdaten entfernt."
fi

# ---------- 1. Dienst anhalten ----------
if [ -x "$DIENST" ]; then
    "$DIENST" stop >/dev/null 2>&1 || true
fi
PID="$BASE/data/plugins/$PFOLDER/dienst.pid"
if [ -f "$PID" ]; then
    P=$(cat "$PID" 2>/dev/null)
    # Nur beenden, wenn der Prozess noch lebt UND argumentweise unser Dienst
    # ist - Prozessnummern werden wiederverwendet. Erst freundlich, bis zu zehn
    # Sekunden Zeit, dann hart: der Dienst haelt eine offene HTTP-Sitzung zur
    # Anker-Cloud und schreibt seine Dateien ueber os.replace(); ein SIGKILL
    # genau dazwischen laesst Unfertiges liegen (dieselbe Begruendung wie in
    # preupgrade.sh).
    if [ -n "$P" ] && kill -0 "$P" 2>/dev/null && ak_ist_dienst "$P"; then
        kill "$P" 2>/dev/null || true
        i=0
        while [ $i -lt 10 ] && kill -0 "$P" 2>/dev/null && ak_ist_dienst "$P"; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$P" 2>/dev/null && ak_ist_dienst "$P"; then
            kill -9 "$P" 2>/dev/null || true
        fi
    fi
    rm -f "$PID"
fi
# Dazu jeder eigene Dienst OHNE PID-Datei: ein zweiter, den der Minutentakt
# waehrend eines fruehreren Upgrades gestartet hat, hat keine. In WSL gemessen
# (Pruefung-AnkerSolix-0.9.17, Fall 7): ohne diesen Schritt lief er nach dem
# Entfernen des Plugins weiter - mit einem Dienstskript, das es nicht mehr gibt.
WAISEN=$(ak_dienste_beenden)
if [ -n "$WAISEN" ]; then
    echo "<INFO> Ein Dienst ohne PID-Datei lief und wurde beendet (PID $WAISEN)."
fi

# ---------- 2. Anlage freigeben ----------
# Erst NACH dem Anhalten (Befund Installer 3): bis 0.9.21 lief die
# Rueckstellung vor Block 1, ohne eigene Schranke - hing sie, kam keine
# Zeile, der Dienst lief weiter und die Sicherungen mit dem Klartextpasswort
# blieben liegen; und ein in diesem Augenblick abgearbeiteter Befehl des
# laufenden Dienstes konnte einen Sollwert NACH der Rueckstellung setzen.
#
# Nur versuchen, wenn die Steuerung freigegeben war. War sie es nie, hat
# dieses Plugin auch nie einen Sollwert gesetzt, und ein Schreibbefehl beim
# Deinstallieren waere ein Eingriff ohne Anlass. "Freigegeben" heisst 1 ODER
# true (Befund Installer 4): Dienst und Endpunkt werten beides als ein.
if [ -x "$PY" ] && [ -f "$SKRIPT" ] && [ -f "$PCONFIG/ankersolix.json" ] \
   && grep -Eq '"steuerung_ein"[[:space:]]*:[[:space:]]*(1|true)([^0-9A-Za-z_.]|$)' "$PCONFIG/ankersolix.json" 2>/dev/null; then
    # 120 s Schranke; -k 10: wer SIGTERM ueberhoert, wird danach beendet.
    if command -v timeout >/dev/null 2>&1; then
        timeout -k 10 120 "$PY" "$SKRIPT" --freigeben >/dev/null 2>&1
    else
        "$PY" "$SKRIPT" --freigeben >/dev/null 2>&1
    fi
    FREI_RC=$?
    if [ "$FREI_RC" = 0 ]; then
        echo "<OK> Die Anlage wurde auf Eigenverbrauch zurueckgestellt."
    elif [ "$FREI_RC" = 124 ] || [ "$FREI_RC" = 137 ]; then
        echo "<WARNING> Die Rueckstellung auf Eigenverbrauch wurde nach 120 s abgebrochen (Zeitueberschreitung)."
        echo "<WARNING> Bitte die Betriebsart in der Anker-App selbst pruefen -"
        echo "<WARNING> ein gestellter Hauslast-Sollwert bleibt sonst stehen."
    else
        echo "<INFO> Die Rueckstellung auf Eigenverbrauch ist nicht gelungen."
        echo "<INFO> Bitte die Betriebsart in der Anker-App selbst pruefen -"
        echo "<INFO> ein gestellter Hauslast-Sollwert bleibt sonst stehen."
    fi
fi

# ---------- 2b. Zurueckbehaltene MQTT-Themen abraeumen ----------
# Seit 0.9.22 gehen Zustaende retained hinaus (Entscheidung des Hausherrn
# 29.09.2026). Ohne dieses Abraeumen blieben sie nach dem Entfernen fuer immer
# im Broker und kaemen nach jedem Neustart von Gateway oder Miniserver als
# frisch heraus. Seit 0.9.32 (K22, E-E9): mit Ruecklesen am Broker, je Praefix,
# unter dem je retained gesendet wurde (Merker data/<o>/mqtt_praefixe.json und
# seine Zweitschrift config/plugins/<o>.mqtt_praefixe.json) - auch bei
# mqtt_ein = 0. NACH dem Anhalten, damit der Dienst nichts nachschiebt, und VOR
# dem Abraeumen des Datenordners. Als loxberry, wenn dieses Skript als root
# laeuft (es liest und sendet nur), hoechstens 60 s, mit LBHOMEDIR und
# LBPPLUGINDIR (K17). Das Broker-Kennwort liest der Dienst selbst aus
# general.json - es steht in keiner Befehlszeile (Regeln/05).
AK_PY="$PY"
[ -x "$AK_PY" ] || AK_PY=$(command -v python3 2>/dev/null)
if [ -n "$AK_PY" ] && [ -f "$SKRIPT" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        ABR=$(su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" \
            timeout -k 5 60 "$AK_PY" "$SKRIPT" --abraeumen)" < /dev/null 2>/dev/null)
    elif command -v timeout >/dev/null 2>&1; then
        ABR=$(env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" timeout -k 5 60 "$AK_PY" "$SKRIPT" --abraeumen \
            < /dev/null 2>/dev/null)
    else
        ABR=$(env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" "$AK_PY" "$SKRIPT" --abraeumen < /dev/null 2>/dev/null)
    fi
    ABR_RC=$?
    if [ -n "$ABR" ]; then
        echo "$ABR"
    elif [ "$ABR_RC" != 0 ]; then
        echo "<WARNING> Die zurueckbehaltenen MQTT-Themen liessen sich nicht abraeumen (Rueckgabe $ABR_RC)."
    fi
fi

# ---------- 3. Sicherungen und Daten abraeumen ----------
ANZAHL=0
# Dazu die .alt, die preinstall.sh (als Rueckfall postinstall.sh) bei einer
# Neuinstallation beiseitelegt
# (Befund Installer 1) - auch sie tragen das Klartextpasswort.
for f in ankersolix.json zugang.json; do
    for BK in "$BASE/config/plugins/$PFOLDER.backup.$f" "$BASE/config/plugins/$PFOLDER.backup.$f.alt"; do
        if [ -f "$BK" ]; then
            rm -f "$BK" && ANZAHL=$((ANZAHL + 1))
        fi
    done
done
# K17 (seit 0.9.32): Nebendateien eines abgebrochenen Sicherns (preupgrade.sh,
# <name>.neu.<pid>) tragen dieselben Geheimnisse.
for BKN in "$BASE/config/plugins/$PFOLDER".backup.*.neu.*; do
    [ -f "$BKN" ] && rm -f "$BKN" && ANZAHL=$((ANZAHL + 1))
done
rm -rf "$BASE/data/plugins/$PFOLDER"
# Die Zweitschrift des Praefix-Merkers (K22, seit 0.9.32).
rm -f "$BASE/config/plugins/$PFOLDER.mqtt_praefixe.json"

# Die beiden Merker, die preupgrade.sh NEBEN den Ordnern anlegt. Sie
# ueberstehen jedes Abraeumen des Installers, weil sie eine Ebene darueber
# liegen - genau deshalb gibt es sie.
#
#   .upgrade_laeuft  wuerde eine Stunde lang jeden Dienststart und die
#                    Oberflaeche einer NEUinstallation sperren;
#   .backup.lief     wuerde eine Neuinstallation den Dienst anwerfen lassen,
#                    obwohl es noch keine Zugangsdaten gibt - postinstall.sh
#                    meldet dann "lief vor dem Upgrade, liess sich aber nicht
#                    starten", und niemand versteht, wovon die Rede ist.
rm -f "$BASE/data/plugins/$PFOLDER.upgrade_laeuft"
# Der Einbaumerker aus postinstall.sh (Befund Installer 2).
rm -f "$BASE/data/plugins/$PFOLDER.postinstall_lauf"
rm -f "$BASE/config/plugins/$PFOLDER.backup.lief"

echo "<OK> Anker SOLIX entfernt, $ANZAHL Sicherungsdatei(en) geloescht."
echo "<INFO> Das Anker-Konto selbst ist davon nicht beruehrt."
exit 0
