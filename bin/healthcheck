#!/usr/bin/env php
<?php
/**
 * Anker SOLIX - Anschluss an den LoxBerry-Healthcheck (seit 0.9.32, V4, E-E14; Bauart Docker NG 1.3.20)
 *
 * LoxBerry ruft eine ausfuehrbare Datei bin/healthcheck des Plugins direkt auf (nie mit bash, als loxberry;
 * Regeln/02) - einmal mit 'title', einmal mit 'check'. Der Installer legt bin/ rekursiv mit 755 an.
 *
 * Antwort: JSON mit desc, status, result, logfile. Status nach der Skala von LoxBerry: 3 = Fehler (rot),
 * 4 = Warnung (gelb), 5 = in Ordnung (gruen), 6 = Hinweis (blau).
 *
 * KEINE Cloud-Anfrage und KEIN Broker - nur Dateien, die es gibt (ak_gesundheit()): Dienst soll laufen und
 * laeuft nicht, der letzte erfolgreiche Abruf ist aelter als melden_alter (3); der Waechter griff in den
 * letzten 24 h, die Befehlsbruecke soll laufen und haengt, MQTT an ohne UDP-Eingang des Gateways (4); noch
 * nicht eingerichtet, Preisquelle schweigt (6); sonst 5.
 *
 * NEBENEFFEKT OHNE ZUSATZARBEIT: healthcheck.pl veroeffentlicht das Ergebnis zusaetzlich retained nach MQTT
 * unter <rechnername>/healthcheck/Anker SOLIX (Regeln/03) - kein eigenes MQTT dieses Plugins.
 */

error_reporting(E_ALL & ~E_DEPRECATED & ~E_NOTICE);
ini_set('display_errors', '0');

$ak_lib = '';
foreach (array(
    dirname(dirname(dirname(__DIR__))) . '/webfrontend/html/plugins/' . basename(__DIR__) . '/ak_lib.php',
    dirname(__DIR__) . '/webfrontend/html/ak_lib.php',
) as $ak_k) {
    if (is_file($ak_k)) { $ak_lib = $ak_k; break; }
}

$ak_was = isset($argv[1]) ? strtolower((string) $argv[1]) : 'check';

if ($ak_was === 'title') {
    echo "Anker SOLIX\n";
    exit(0);
}

if ($ak_lib === '') {
    // Fail closed, und mit Begruendung.
    echo json_encode(array(
        'desc'   => 'Anker SOLIX',
        'status' => 3,
        'result' => 'Die Bibliothek ak_lib.php wurde nicht gefunden - das Plugin ist unvollstaendig installiert.',
    )) . "\n";
    exit(0);
}
require_once $ak_lib;

list($ak_status, $ak_text) = ak_gesundheit();

echo json_encode(array(
    'desc'    => 'Anker SOLIX',
    'status'  => (int) $ak_status,
    'result'  => (string) $ak_text,
    'logfile' => ak_paths()['log'],
), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
exit(0);
